    "ai": "^6.0.81",
    "better-auth": "^1.5.1",
    "chromadb": "^3.3.0",
    "dotenv": "^17.3.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "jspdf": "^4.2.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "node-fetch": "^2.7.0",
    "openai": "^6.22.0",
    "papaparse": "^5.5.3",
    "pg": "^8.19.0",
    "react": "19.2.3",

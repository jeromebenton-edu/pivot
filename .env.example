# LLM API Configuration (Choose one)
# =====================================

# Option 1: OpenAI (Recommended for Enterprise)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option 2: Anthropic Claude
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Note: If both keys are present, OpenAI will be used by default.
# A provider that fails with a terminal error (quota exhausted, invalid key) is
# skipped for a 5 minute cooldown, so requests go straight to the other one.

# Optional: pin the primary provider ("openai" or "anthropic"). The other key,
# if set, is still used as a fallback. Ignored when that provider has no key.
LLM_PROVIDER=

# Chroma Cloud authentication
# Get your API key from https://trychroma.com dashboard
CHROMA_API_KEY=

# Chroma Cloud collection name
# Set this to match your embeddings collection
CHROMA_COLLECTION_NAME=pivot-embeddings

# Voyage AI embedding model
# Get your API key from https://voyageai.com dashboard
VOYAGE_API_KEY=

# Base URL for deployed app (used in production)
# This will be automatically set by Vercel
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Authentication (Better Auth)
# Generate with: openssl rand -base64 32
# Also accepts NEXTAUTH_SECRET for backwards compatibility
BETTER_AUTH_SECRET=

# PostgreSQL (optional - enables SQL aggregation layer)
# Without this, the app uses in-memory mock data (same as before)
# Works with local PostgreSQL or Supabase (both standard PG)
# Example: postgresql://user:password@localhost:5432/pivot
#
# Vercel scoping: DATABASE_URL and the Supabase vars below are intentionally
# scoped to Production only. Preview deployments run DB-less on purpose so a
# preview never reads or writes production data — they build and serve, but
# DB-backed features (auth persistence, sessions, SQL analytics, dashboards)
# are inert. Validate those against a local DB or production, not a preview.
# To make previews fully functional, provision a SEPARATE preview database
# rather than copying the production connection string into Preview scope.
DATABASE_URL=

# Chroma Cloud URL (optional - enables persistent vector store)
# Without this, the app uses in-memory vector store
# Get from https://trychroma.com dashboard
CHROMA_CLOUD_URL=

# Supabase (optional - falls back to in-memory storage)
# Get from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry (optional - error tracking)
# Get from https://sentry.io project settings
SENTRY_DSN=

# Forecast Microservice (optional - enables real SARIMAX forecasting)
# Without this, the app uses a local weighted-average fallback
FORECAST_SERVICE_URL=http://localhost:8001

# Demo Mode (development only - CANNOT be used in production)
# DEMO_MODE=true
